# URL do Apps Script implantado como "App da Web" (termina em /exec)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Mesmo valor da propriedade TOKEN no Apps Script (gere uma senha longa e aleatória)
GOOGLE_SCRIPT_TOKEN=troque-por-um-token-longo
# Meta Pixel (público)
NEXT_PUBLIC_META_PIXEL_ID=1148201590991632
# Conversions API (opcional, recomendado): Gerenciador de Eventos > Pixel > Configurações > Gerar token de acesso
META_CAPI_TOKEN=
# Opcional: código de teste da aba "Testar eventos" (remova em produção)
META_TEST_EVENT_CODE=
